# Smart Barber API Base URL
EXPO_PUBLIC_API_URL=https://api-black-theta-13.vercel.app

# Disponibilidade
# Use "mock" no desenvolvimento visual e "http" para integrar com a API.
EXPO_PUBLIC_AVAILABILITY_SOURCE=mock


# Google Maps: chave web pública, restrita aos domínios autorizados.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Chaves dos SDKs nativos, restritas ao app/certificado. Entram no build nativo.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Nunca cadastrar GOOGLE_MAPS_API_KEY ou CRON_SECRET neste frontend.
