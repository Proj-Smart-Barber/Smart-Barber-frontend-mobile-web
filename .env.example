# Smart Barber API Base URL
EXPO_PUBLIC_API_URL=https://api-black-theta-13.vercel.app

# Disponibilidade
# Use "mock" no desenvolvimento visual e "http" para integrar com a API.
EXPO_PUBLIC_AVAILABILITY_SOURCE=mock

# Compatibilidade temporária com a branch feat/availability-engine:
# o backend atual ainda não devolve barbershopId/timezone pelo perfil nem
# expõe GET /barbershops/:id.
EXPO_PUBLIC_BARBERSHOP_ID=barbershop-seed-0001
EXPO_PUBLIC_BARBERSHOP_NAME=Barbearia Exemplo
EXPO_PUBLIC_BARBERSHOP_TIMEZONE=America/Sao_Paulo
